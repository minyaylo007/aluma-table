# ALUMA — суточна чистка бази SQLite (одноразовий запуск, кличе таймер).
# КОРИСТУВАЦЬКИЙ юніт; системна версія — ../aluma-purge.service.
#
# Файли юнітів у ~/.config/systemd/user/ оновлює агент деплою разом із версією; таймер вмикається один раз
# (systemctl --user enable --now ihor-aluma-purge.timer).
#
# Перевірити руками, не чекаючи доби:
#   systemctl --user start ihor-aluma-purge.service
#   journalctl --user -u ihor-aluma-purge -n 20
#
# Відмінності від системної версії — ті самі, що в ihor-aluma-api.service:
# нема User=/Group=, оточення з %h/.config/aluma, прибрано PrivateTmp,
# ProtectSystem, ProtectHome, ReadWritePaths (у менеджері користувача на цій
# машині вони мовчки не діють — заміри в коментарі ihor-aluma-api.service).

[Unit]
Description=ALUMA — purge expired rows + VACUUM (SQLite has no TTL, user unit)
Documentation=file:///opt/ihor/aluma-table/current/deploy/README.md
# База та сама, що в ihor-aluma-api: сервіс не зупиняємо, SQLite у режимі WAL
# спокійно переживає паралельний DELETE. VACUUM візьме коротке блокування.

[Service]
Type=oneshot
WorkingDirectory=/opt/ihor/aluma-table/current

# Той самий файл, що й у API: потрібні FX_DB_PATH і, якщо задані, імена таблиць.
EnvironmentFile=%h/.config/aluma/aluma.env

ExecStart=/opt/ihor/aluma-table/current/.venv/bin/python scripts/purge.py

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aluma-purge

NoNewPrivileges=true
# VACUUM перестворює файл бази — з umask процесу. 0077: лише для ihor (див. api-юніт).
UMask=0077
