# Зразок /etc/aluma/aluma.env — ЗАПОВНЮЄ ВЛАСНИК НА СЕРВЕРІ.
#
# Це ЗРАЗОК. Реальних значень тут нема і НІКОЛИ не буде: секрети не потрапляють
# ні в git, ні в чат, ні в логи. Сьогодні ADMIN_PASS / IP_SALT / TELEGRAM_BOT_TOKEN
# приходять параметрами SAM з NoEcho (infra/template.yaml) — так і має лишитися.
#
# Установка:
#   sudo install -d -m 0750 -o root -g ihor /etc/aluma
#   sudo install -m 0640 -o root -g ihor deploy/aluma.env.example /etc/aluma/aluma.env
#   sudo nano /etc/aluma/aluma.env      # вписати значення
#
# Формат — KEY=VALUE, без лапок і без 'export' (systemd EnvironmentFile).
# Читає це все api/handler.py:48-64.


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  ПОПЕРЕДЖЕННЯ 1.  EDGE_SECRET СЮДИ НЕ ПЕРЕНОСИТИ. ЗОВСІМ.                 ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# EDGE_SECRET має сенс РІВНО як спільний секрет із CloudFront: CDN підставляє
# заголовок x-fx-edge, лямбда його звіряє. Після переїзду на цей сервер
# CloudFront зникає — підставляти заголовок нема кому.
#
# Якщо задати EDGE_SECRET тут, увімкнеться перевірка handler.py:924-926:
#
#     if EDGE_SECRET:
#         sent = (event.get("headers") or {}).get("x-fx-edge", "")
#         if not hmac.compare_digest(sent, EDGE_SECRET):
#             return resp(403, {"ok": False, "error": "forbidden"})
#
# Перевірка стоїть ПЕРЕД маршрутизацією, тобто 403 віддасть УСЕ: /api/fx/health,
# /api/fx/lead, /api/fx/event і АДМІНКУ теж. Браузер такого заголовка не шле
# ніколи. Наслідок — сайт живий, заявки не доходять, у адмінку не зайти.
#
# Тому змінної EDGE_SECRET у цьому файлі нема навмисно. Не додавати.


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  ПОПЕРЕДЖЕННЯ 2.  IP_SALT і ADMIN_PASS ПЕРЕНОСИТИ НЕЗМІННИМИ.            ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# Підпис куки адмінки будується так (handler.py:554):
#
#     def _session_secret() -> bytes:
#         return (ADMIN_PASS + "|" + IP_SALT + "|fx-admin").encode("utf-8")
#
# Інша сіль або інший пароль — інший секрет — усі вже видані токени миттєво
# недійсні. Власника викине з адмінки РІВНО в момент переїзду, і він
# подумає, що переїзд зламав вхід.
#
# Другий бік тієї ж монети: IP_SALT солить хеш IP (hash_ip, handler.py:154-157),
# на якому будуються ведра обмежувача і поле ip_hash у збережених заявках.
# Змінили сіль — старі й нові рядки більше не звести між собою, а ліміти
# обнуляться для всіх.
#
# Значення беруться з чинного стека (параметри SAM), переносяться СИМВОЛ У СИМВОЛ.


# ── Адмінка ─────────────────────────────────────────────────────────────────
# Логін і пароль до /admin. ADMIN_PASS — ще й половина секрету підпису куки,
# див. ПОПЕРЕДЖЕННЯ 2.
ADMIN_USER=
ADMIN_PASS=

# Сіль для хешу IP. Див. ПОПЕРЕДЖЕННЯ 2 — переносити незмінною.
IP_SALT=


# ── Сайт ────────────────────────────────────────────────────────────────────
# Канонічний домен (посилання, куки, редиректи). Дефолт у коді —
# table.central-aparts.store.
SITE_DOMAIN=table.central-aparts.store

# Версія, яку віддає GET /api/fx/health (handler.py:931).
#
# ОБОВʼЯЗКОВО ВІДМІННА ВІД 0.3.0. Прод СЬОГОДНІ віддає 0.3.0. Якщо після
# переїзду health знову покаже 0.3.0 — неможливо зрозуміти, який стек
# відповів: новий gunicorn чи стара лямбда за CloudFront. Це єдина дешева
# перевірка того, що трафік реально приїхав на сервер.
APP_VERSION=0.4.0

# Номер WhatsApp для кнопки звʼязку.
# ЧЕСНО: api/handler.py його НЕ читає — змінна лишилася в infra/template.yaml:131
# з часів, коли номер підставлявся на боці API. Кладемо для повноти й щоб
# оточення сервера збігалося з оточенням лямбди; на поведінку сервера не впливає.
WHATSAPP_NUMBER=


# ── Сповіщення про заявку ───────────────────────────────────────────────────
# Обидві порожні = сповіщення просто вимкнені, заявка все одно збережеться
# (handler.py notify() ніколи не валить запит).
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=


# ── Сховище ─────────────────────────────────────────────────────────────────
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  FX_STORAGE ЗАДАВАТИ ЯВНО. ЦЕ ПЕРЕМИКАЧ СХОВИЩА, А НЕ НАЛАШТУВАННЯ.       ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# handler.py:63 — os.environ.get("FX_STORAGE", "sqlite"), а _tables()
# (handler.py:89-108) читає це так: рівно "sqlite" — файл на диску через
# api/store.py, БУДЬ-ЩО ІНШЕ (і будь-яка помилка в написанні теж) — DynamoDB.
#
# 1. НА ЦЬОМУ СЕРВЕРІ пишемо FX_STORAGE=sqlite ЯВНО, не покладаючись на дефолт.
#    Дефолт сьогодні збігається з потрібним значенням — і саме тому його
#    відсутність ніхто не помітить, якщо дефолт колись поміняють. Рядок в
#    оточенні коштує нуль; мовчазна залежність від дефолту живе до першого
#    сюрпризу.
#
# 2. У БОЙОВІЙ ЛЯМБДІ змінної FX_STORAGE зараз НЕМА ВЗАГАЛІ — саме по її
#    відсутності видно, що новий код у прод ще не їхав. У infra/template.yaml:141
#    уже прописано FX_STORAGE: dynamodb з поясненням, тож штатний `sam deploy`
#    це закриває. Небезпека лишається тільки в обхід шаблону: якщо новий код
#    потрапить у Lambda БЕЗ цієї змінної (ручна заливка коду, деплой старим
#    шаблоном), handler мовчки обере sqlite і почне писати файл на ефемерний
#    диск лямбди. Заявки будуть губитися БЕЗ ЖОДНОЇ ПОМИЛКИ В ЛОЗІ.
#    Умова переїзду: у Lambda FX_STORAGE=dynamodb, на сервері FX_STORAGE=sqlite,
#    і обидва — явно.
FX_STORAGE=sqlite

# Шлях до бази. Відносний рахується від WorkingDirectory юніта — краще
# абсолютний. Тека має бути в ReadWritePaths юніта (там же лягають -wal і -shm).
FX_DB_PATH=/opt/ihor/aluma-table/data/aluma.db

# Необовʼязкові: імена трьох таблиць. Дефолти fx_events / fx_leads / fx_sessions
# (handler.py:48-50) збігаються з бойовими — задавати треба тільки якщо тримаєте
# на одній машині дві бази (наприклад, staging).
# EVENTS_TABLE=fx_events
# LEADS_TABLE=fx_leads
# SESSIONS_TABLE=fx_sessions
